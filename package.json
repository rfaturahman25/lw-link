{
  "name": "lw-link",
  "version": "0.1.0",
  "description": "Internal Linktree-like application for company use",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite --port 5173",
    "dev:backend": "wrangler dev --port 8787 --local",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build",
    "build:backend": "wrangler deploy --dry-run",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "typecheck:frontend": "tsc -p tsconfig.frontend.json --noEmit",
    "typecheck:backend": "tsc -p tsconfig.backend.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "wrangler d1 migrations apply lw-link-db",
    "db:migrate:local": "wrangler d1 migrations apply lw-link-db --local",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "@tanstack/react-query": "^5.17.19",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^7.0.2",
    "@dnd-kit/utilities": "^3.2.2",
    "react-dropzone": "^14.2.3",
    "qrcode.react": "^3.1.0",
    "lucide-react": "^0.300.0",
    "hono": "^3.12.1",
    "@hono/zod-validator": "^0.2.1",
    "zod": "^3.22.4",
    "drizzle-orm": "^0.29.3"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/node": "^20.11.5",
    "@types/bcryptjs": "^2.4.6",
    "@cloudflare/workers-types": "^4.20231121.0",
    "vite": "^5.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "tailwindcss": "^3.3.6",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.33",
    "wrangler": "^3.21.0",
    "drizzle-kit": "^0.21.0",
    "vitest": "^1.1.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/user-event": "^14.5.2",
    "jsdom": "^23.0.1",
    "tsx": "^4.7.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "prettier": "^3.1.1",
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "linktree",
    "cloudflare",
    "workers",
    "react",
    "typescript",
    "internal"
  ],
  "author": "LW-link Team",
  "license": "MIT"
}
