# Environment variables template
# Copy to .dev.vars for local wrangler dev (do NOT commit .dev.vars)

# App
NODE_ENV=development
APP_NAME=LW-link
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8787

# Session
SESSION_SECRET=development-secret-change-in-production-min-32-chars

# Future OAuth (not required for Phase 1)
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=

# Future OpenRouter (not required for MVP)
# OPENROUTER_API_KEY=
