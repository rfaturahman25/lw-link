{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "lw-link",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/backend/index.ts",
  
  "routes": [
    {
      "pattern": "links.lensawaktu.id/*",
      "zone_name": "lensawaktu.id"
    }
  ],

  "assets": {
    "directory": "dist/frontend",
    "not_found_handling": "single-page-application"
  },
  
  "vars": {
    "APP_NAME": "LW-link",
    "NODE_ENV": "production",
    "SESSION_SECRET": "@session_secret",
    "ALLOWED_ORIGINS": "https://links.lensawaktu.id"
  },
  
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lw-link-db",
      "database_id": "14fb9c06-9e4f-4501-8a48-8457e9d46851",
      "migrations_dir": "migrations"
    }
  ],
  
  "observability": {
    "enabled": true
  },
  
  "env": {
    "development": {
      "vars": {
        "NODE_ENV": "development",
        "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:8787",
        "SESSION_SECRET": "development-secret-key-change-in-production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lw-link-dev",
          "database_id": "local",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}